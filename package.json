{
  "name": "fmr",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/check-ui.js && node scripts/check-sql.js && node --test packages/core/test/*.test.js",
    "test:db": "node --test packages/core/test/db/*.test.js",
    "migrate": "node packages/core/src/db/migrate.js",
    "api": "node packages/api/src/server.js",
    "start": "./start-local.sh",
    "start:reset": "./start-local.sh --reset",
    "check:ui": "node scripts/check-ui.js",
    "check:sql": "node scripts/check-sql.js"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
