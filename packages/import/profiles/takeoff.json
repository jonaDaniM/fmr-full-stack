{
  "name": "Takeoff toolkit FMR",
  "description": "Workbooks generated by the ISO takeoff pipeline. Column letters and header wording taken from 140 real outputs; copy and adjust for a project whose template differs.",

  "headerSearchRows": 12,
  "stopAfterBlankRows": 4,
  "defaultSheet": "01",

  "skipSheets": ["^instructions", "^notes$", "^legend", "^cover", "^template"],
  "stopPatterns": [
    "^REASON REQUIRED",
    "^ACTION TAKEN",
    "^NOT SHOWN ON",
    "^total",
    "^grand total"
  ],

  "header": {
    "iwpNumber":    { "aliases": ["IWP", "IWP:", "IWP No", "IWP Number"], "required": true },
    "isoNumber":    { "aliases": ["LINE NO", "LINE NO:", "ISO No", "Drawing No", "ISO"], "required": true },
    "isoSheet":     { "aliases": ["SHT", "SHT:", "Sheet", "Sheet No"] },
    "isoRevision":  { "aliases": ["REV", "REV:", "Revision"] },
    "fmrNumber":    { "aliases": ["FMR NO.", "FMR NO", "FMR No", "FMR Number", "FMR #"] },
    "requestedBy":  { "aliases": ["Requested By", "Requestor", "REQUESTED BY"] },
    "dateRequired": { "aliases": ["DATE REQUIRED:", "DATE REQUIRED", "Date Required", "Need By"] },
    "destination":  { "aliases": ["DELIVER TO:", "DELIVER TO", "Destination"] },
    "priority":     { "aliases": ["Priority", "PRIORITY", "Urgency"] }
  },

  "requiredColumns": ["quantity", "description"],

  "columns": {
    "commodityCode": ["Commodity Code", "COMMODITY CODE", "Commodity", "Ident", "IDENT", "Code"],
    "size":          ["Size", "SIZE", "NPD", "NPS", "Dia"],
    "quantity":      ["Quantity", "QUANTITY", "Qty", "QTY", "Qty Req"],
    "description":   ["Material Description", "MATERIAL DESCRIPTION", "Description", "DESCRIPTION"],
    "issued":        ["Issued", "ISSUED"],
    "backordered":   ["Back Ordered", "BACK ORDERED", "Backordered"],
    "actionTaken":   ["Action Taken", "ACTION TAKEN"]
  }
}
