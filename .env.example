DATABASE_URL=postgres://localhost/fmr
SESSION_SECRET=generate-with-openssl-rand-hex-32
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
PORT=3000

# Reading drawing PDFs. Without these the other imports still work and only the
# drawing upload refuses, saying the reader is not installed.
#   cd ../Archive && python3 -m venv .venv && .venv/bin/pip install -e .
FMR_PYTHON=../Archive/.venv/bin/python
FMR_EXTRACT_HOME=../Archive
FMR_EXTRACT_TIMEOUT_MS=300000
